{
  "name": "chronos",
  "type": "module",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --filter @chronos/frontend dev & bun --filter @chronos/backend dev",
    "dev:remote": "bun --filter @chronos/frontend dev & bun --filter @chronos/backend dev:remote",
    "build": "bun --filter '*' build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
