{
  "name": "chronos",
  "type": "module",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "build": "bun --filter '*' build",
    "migrate:dev": "bun --filter @chronos/backend migrate:dev",
    "migrate:pre": "bun --filter @chronos/backend migrate:pre",
    "migrate:prod": "bun --filter @chronos/backend migrate:prod"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
