{
  "name": "@chronos/backend",
  "type": "module",
  "scripts": {
    "dev:local": "bunx wrangler dev --local",
    "dev:remote": "bunx wrangler dev --env development",
    "pre:remote": "bunx wrangler dev --env preview",
    "prod:remote": "bunx wrangler dev",

    "build": "bun build src/index.ts --outfile=dist/index.js --target=bun",

    "migrate:local":"bunx wrangler d1 execute DB --local --file=migrations/schema.sql",
    "migrate:dev":"bunx wrangler d1 execute DB --remote --env development --file=migrations/schema.sql",
    "migrate:pre":"bunx wrangler d1 execute DB --remote --env preview --file=migrations/schema.sql",
    "migrate:prod":"bunx wrangler d1 execute DB --remote --file=migrations/schema.sql"
  },
  "dependencies": {
    "@chronos/types": "workspace:*",
    "hono": "^4.10.6",
    "wrangler": "^4.50.0"
  }
}
