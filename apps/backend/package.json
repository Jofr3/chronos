{
  "name": "@chronos/backend",
  "type": "module",
  "scripts": {
    "dev": "bunx wrangler dev --env development",
    "pre": "bunx wrangler dev --env preview",
    "prod": "bunx wrangler dev",

    "drizzle": "bunx drizzle-kit studio",

    "build": "bun build src/index.ts --outfile=dist/index.js --target=bun",

    "migrate:dev": "bunx wrangler d1 execute DB --env development",
    "migrate:pre": "bunx wrangler d1 execute DB --env preview",
    "migrate:prod": "bunx wrangler d1 execute DB"
  },
  "dependencies": {
    "@chronos/types": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.10.6",
    "wrangler": "^4.50.0"
  },
  "devDependencies": {
    "better-sqlite3": "^12.5.0",
    "drizzle-kit": "^0.31.8"
  }
}
